# Required
OPENROUTER_API_KEY=

# OpenRouter configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RESEARCH_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional research services
RESEARCH_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
USE_GROBID=false
GROBID_URL=http://localhost:8070

# Local storage
CORPUS_DB_PATH=corpus.db
EXTRACTION_DB_PATH=extraction.db
PDF_DIR=corpus/pdfs
OUTPUT_DIR=export

# Paper configuration
PAPER_TYPE=survey
TARGET_VENUE=
PAGE_LIMIT=0
DEADLINE=
TOP_N_GAPS=3
TOTAL_WORD_LIMIT=8000
MAX_REVISION_ROUNDS=3
MAX_FIX_LOOPS=2
VENUE_TEMPLATE=generic
PAPER_TITLE=
AUTHORS=
CORRESPONDING_EMAIL=
GENERATE_DOCX=false
